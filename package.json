{
  "name": "markpublisher",
  "version": "1.3.0",
  "description": "Convert extended Markdown into styled HTML and PDF for professional book publishing",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "markpublisher": "src/cli.js",
    "create-markpublisher-book": "src/cli.js"
  },
  "files": [
    "src/",
    "samples/sample-book/",
    "!samples/sample-book/output/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --experimental-test-coverage test/**/*.test.js",
    "build": "node src/cli.js build",
    "serve": "node src/cli.js serve"
  },
  "keywords": [
    "markdown",
    "pdf",
    "publishing",
    "book",
    "typesetting"
  ],
  "license": "MIT",
  "author": "Ernesto Cruz Olivera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecruzolivera/markpublisher.git"
  },
  "homepage": "https://github.com/ecruzolivera/markpublisher#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.2.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "puppeteer": "^25.1.0",
    "toml": "^4.1.1"
  }
}
