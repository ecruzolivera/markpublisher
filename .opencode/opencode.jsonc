{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      // "model": "github-copilot/claude-sonnet-4.6",
    },
    "build": {
      "model": "opencode-go/deepseek-v4-pro",
      //"model": "github-copilot/claude-sonnet-4.6",
    },
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true,
    },
  },
}
